# Copia a .env para desarrollo local (no se versiona).

# Firma de sesiones y códigos OTP. Generar con:
#   python -c "import os;print(os.urandom(32).hex())"
SECRET_KEY=pega-aqui-una-clave-larga-y-aleatoria

# Correos con acceso (separados por coma). Si se omite, aplica la lista
# por defecto: aaguirre@prestamype.com, rhinojosa@prestamype.com
ALLOWED_EMAILS=aaguirre@prestamype.com,rhinojosa@prestamype.com

# --- Envío de códigos (elegir UNA vía) ---

# Vía recomendada (funciona en Render, que bloquea SMTP saliente):
# API de Brevo. La clave se crea en Brevo -> SMTP y API -> Claves API.
BREVO_API_KEY=xkeysib-...
SMTP_FROM=aaguirre@prestamype.com   # remitente verificado en Brevo

# Vía alternativa (hosts que sí permiten SMTP saliente):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=b1761...@smtp-brevo.com
# SMTP_PASSWORD=clave-smtp

# Sin nada configurado (desarrollo), el PIN se imprime en los logs.

# --- Panel de administración ---
# Correos con acceso a /admin (separados por coma). Solo se otorga aquí.
ADMIN_EMAILS=aaguirre@prestamype.com

# --- Origen de los datos ---
# local (por defecto) | carpeta | dropbox | github
DATA_ORIGEN=dropbox

# Modo dropbox (recomendado si quieres arrastrar el CSV y listo).
# App creada en https://www.dropbox.com/developers/apps con permisos
# files.content.read y files.content.write.
DROPBOX_APP_KEY=...
DROPBOX_APP_SECRET=...
DROPBOX_REFRESH_TOKEN=...
# DATA_CARPETA_DROPBOX=growth-dashboards   # carpeta raíz dentro de Dropbox

# Modo github (recomendado en Render): repo privado solo con la data,
# con una carpeta por proyecto (fast_track/, descuento_en_tasas/, ...).
DATA_REPO=usuario/growth-data
DATA_TOKEN=github_pat_...        # Contents: Read and write sobre ese repo
# DATA_RAMA=main
# DATA_PREFIJO=proyectos         # subcarpeta base dentro del repo, opcional

# Modo carpeta: ruta base (disco montado, unidad de red, carpeta sincronizada)
# DATA_CARPETA=/var/data/growth
